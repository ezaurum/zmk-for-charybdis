#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define HOMEROW 0
#define NAV 1
#define NAV_MOUSE 2
#define MOD 3

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        lb: balanced_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <185>;
            quick-tap-ms = <135>;
            require-prior-idle-ms = <135>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc2 {
            bindings = <&kp ESCAPE>;
            key-positions = <26 27 28>;
        };

        tab2 {
            bindings = <&kp TAB>;
            key-positions = <28 26 15>;
        };

        shift2 {
            bindings = <&kp RSHFT>;
            key-positions = <31 32 33>;
        };

        ctrl2 {
            bindings = <&kp RCTRL>;
            key-positions = <31 20 33>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        homerow {
            display-name = "Base";
            bindings = <
&hm F1 EQUAL  &hm F2 N1   &hm F3 N2   &hm F4 N3    &hm F5 N4    &hm F6 N5    &hm F7 N6  &hm F8 N7    &hm F9 N8    &hm F10 N9  &hm F11 N0     &hm F12 MINUS
&kp TAB       &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y      &kp U        &kp I        &kp O       &kp P          &kp BSLH
&kp ESC       &hm LGUI A  &hm RALT S  &hm LSHFT D  &hm LCTRL F  &kp G        &kp H      &hm RCTRL J  &hm RSHFT K  &hm LALT L  &hm RGUI SEMI  &kp SQT
&mo NAV       &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N      &kp M        &kp COMMA    &kp DOT     &kp FSLH       &mo NAV
                                      &kp LCTRL    &kp BSPC     &kp DEL      &kp ENTER  &kp SPACE
                                                   &mo MOD      &mo NAV_MOUSE             &sk RSHFT
            >;

            sensor-bindings =
                <&scroll_vertical_encoder>,
                <&scroll_horizontal_encoder>;
        };

        nav {
            display-name = "Nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans  &trans     &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans  &kp LBKT   &kp RBKT  &trans
&trans  &trans  &trans  &trans  &trans  &kp GRAVE    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans       &trans    &trans    &trans  &trans     &trans    &trans
                        &trans  &trans  &trans       &trans    &trans
                                &trans  &trans       &trans
            >;
        };

        nav_mouse {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP    &mkp LCLK       &mkp RCLK     &msc SCRL_DOWN   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans        &trans           &trans  &trans
                        &trans  &trans  &trans    &trans          &trans
                                &trans  &trans    &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none  &none            &none            &none            &none            &none
&bootloader     &none         &none         &none         &none         &none           &none  &none            &none            &none            &none            &bootloader
&studio_unlock  &none         &none         &none         &none         &bt BT_CLR      &none  &none            &none            &none            &none            &none
&sys_reset      &none         &none         &none         &none         &none           &none  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &sys_reset
                                            &none         &none         &none           &none  &none
                                                          &trans        &none           &none
            >;
        };
    };
};
