#include "charybdis.dtsi"

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};

// trackball bus
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        scroll-layers = <1>;
        //snipe-layers = <2>;
        // automouse-layer 는 쓰지 않는다. 드라이버 구현은 움직임이 1카운트만 들어와도
        // 무조건 레이어를 켜서, 손바닥이 볼에 스치기만 해도 오작동한다.
        // 대신 아래 trackball_listener 의 zmk,input-processor-temp-layer 를 쓴다.
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};



/ {
    // 트랙볼을 굴리면 AUTOMOUSE(4) 레이어를 잠깐 켜 주는 프로세서.
    // require-prior-idle-ms: 마지막 키 입력 후 이 시간이 지나야 레이어가 켜진다.
    //   타이핑 중 손바닥이 볼을 스쳐도 레이어가 뜨지 않게 하는 핵심 설정.
    // excluded-positions: 이 위치(H/J/K/L = 클릭 키)를 뺀 나머지 키를 누르면
    //   레이어가 즉시 꺼진다. 잘못 켜졌어도 다음 타건에서 바로 원복된다.
    auto_mouse_layer: auto_mouse_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <300>;
        excluded-positions = <30 31 32 33>;
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;
        // <레이어 번호> <유지 시간 ms>
        // 유지 시간은 볼이 멈춘 뒤 클릭 레이어가 남아있는 시간.
        // 이 시간 안이라도 클릭 키(excluded-positions) 외의 키를 누르면 즉시 해제된다.
        input-processors = <&auto_mouse_layer 4 800>;

        // automouse 는 베이스 레이어에서만 뜬다.
        // 레이어를 손으로 잡고 있는 동안 볼을 건드려도 그 레이어가 덮이지 않게,
        // 프로세서 없는 오버라이드를 걸어 base 의 input-processors 를 건너뛴다.
        //   NAV(1)      : 화살표 + scroll-layers 대상
        //   NAV_MOUSE(2): 엄지 홀드 마우스 레이어(mmv/msc)
        //   MOD(3)      : 부트로더/BT
        no_automouse {
            layers = <1 2 3>;
        };
    };
};


